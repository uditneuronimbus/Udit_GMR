{
  "definitions": [
    {
      "title": "GMR Tabs",
      "id": "gmr-tabs",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "gmr-tabs",
              "model": "gmr-tabs",
              "filter": "gmr-tabs"
            }
          }
        }
      }
    },
    {
      "title": "GMR Tab Item",
      "id": "gmr-tabs-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "gmr-tabs-item",
              "model": "gmr-tabs-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "gmr-tabs",
      "fields": [
        {
          "component": "text",
          "name": "mainTitle",
          "label": "Section Title",
          "valueType": "string",
          "defaultValue": "What Makes GMR Different"
        }
      ]
    },
    {
      "id": "gmr-tabs-item",
      "fields": [
        {
          "component": "text",
          "name": "tabTitle",
          "label": "Tab Title",
          "valueType": "string",
          "placeholder": "e.g. Work That Makes A Difference",
          "required": true
        },
        {
          "component": "text",
          "name": "tabId",
          "label": "Tab ID (optional - for JS/anchors)",
          "valueType": "string",
          "placeholder": "e.g. work, life-beyond-job",
          "description": "Lowercase kebab-case recommended"
        },
        {
          "component": "container",
          "name": "cards",
          "label": "Cards in this Tab",
          "multi": true,
          "fields": [
            {
              "component": "reference",
              "name": "icon",
              "label": "Card Icon",
              "valueType": "string"
            },
            {
              "component": "text",
              "name": "cardTitle",
              "label": "Card Title",
              "valueType": "string",
              "required": true
            },
            {
              "component": "richtext",
              "name": "cardDesc",
              "label": "Card Description",
              "valueType": "string"
            }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "gmr-tabs",
      "components": ["gmr-tabs-item"]
    }
  ]
}
