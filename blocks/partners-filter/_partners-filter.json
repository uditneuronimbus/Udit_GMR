{
  "definitions": [
    {
      "title": "Partners Filter",
      "id": "partners-filter",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "partners-filter",
              "model": "partners-filter",
              "filter": "only-partners-items"
            }
          }
        }
      }
    },
    {
      "title": "Partner Listing Item",
      "id": "partner-listing-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "partner-listing-item",
              "model": "partner-listing-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "partners-filter",
      "fields": [
        {
          "component": "dropdown",
          "name": "generalSettings",
          "label": "General Settings",
          "defaultOpen": true,
          "fields": [
            {
              "component": "text",
              "name": "sectionTitle",
              "label": "Section Title (Main Heading)",
              "valueType": "string",
              "placeholder": "Enter section title",
              "required": true
            },
            {
              "component": "text",
              "name": "filterPanelTitle",
              "label": "Filter Sidebar Title",
              "valueType": "string",
              "defaultValue": "Filter by Category",
              "placeholder": "Enter filter panel title"
            }
          ]
        }
      ]
    },
    {
      "id": "partner-listing-item",
      "itemLabel": "title",
      "fields": [
        {
          "component": "dropdown",
          "name": "basicInfo",
          "label": "Basic Information",
          "defaultOpen": true,
          "fields": [
            {
              "component": "select",
              "name": "itemType",
              "label": "Item Category",
              "valueType": "string",
              "options": [
                { "name": "Airports", "value": "airports" },
                { "name": "Energy", "value": "energy" },
                { "name": "Transportation", "value": "transportation" },
                { "name": "GMR Varalakshmi Foundation", "value": "foundation" },
                { "name": "EPC", "value": "epc" }
              ],
              "defaultValue": "airports",
              "required": true
            },
            {
              "component": "text",
              "name": "title",
              "label": "Title / Heading",
              "valueType": "string",
              "placeholder": "Enter partner title",
              "required": true
            }
          ]
        },
        {
          "component": "dropdown",
          "name": "mediaContent",
          "label": "Media & Content",
          "defaultOpen": false,
          "fields": [
            {
              "component": "reference",
              "name": "image",
              "label": "Partner Image",
              "valueType": "string",
              "helpText": "Select or upload a partner logo/image"
            },
            {
              "component": "richtext",
              "name": "description",
              "label": "Description Text",
              "valueType": "string",
              "placeholder": "Enter partner description",
              "helpText": "Add detailed information about the partner"
            }
          ]
        },
        {
          "component": "dropdown",
          "name": "advancedSettings",
          "label": "Advanced Settings",
          "defaultOpen": false,
          "fields": [
            {
              "component": "text",
              "name": "link",
              "label": "Detail Page URL",
              "valueType": "string",
              "placeholder": "https://example.com/partner-details",
              "helpText": "Optional link to partner detail page"
            }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "only-partners-items",
      "components": ["partner-listing-item"]
    }
  ]
}